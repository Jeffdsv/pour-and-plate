server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # api calls go on to the backend container, like the vite proxy does in dev
    location /api/ {
        proxy_pass http://backend:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # nginx doesnt know .mjs files, label them as javascript so the map worker can load
    location ~ \.mjs$ {
        types { application/javascript mjs; }
    }

    # any other path gets index.html, so react can handle links like /invite/abc123
    location / {
        try_files $uri $uri/ /index.html;
    }
}